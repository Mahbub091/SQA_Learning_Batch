# --------------------------------------------------------------------
# 1. Sensitive Data & Credentials (CRITICAL)
# --------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.keystore
*.jks
*.p12

# --------------------------------------------------------------------
# 2. Dependency Folders (Heavy & reproducible)
# --------------------------------------------------------------------
node_modules/
jspm_packages/
.pnpm-store/
.venv/
venv/
env/
ENV/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
vendor/

# --------------------------------------------------------------------
