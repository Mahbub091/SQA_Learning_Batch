# --------------------------------------------------------------------
dist/
build/
out/
target/
bin/
obj/
*.exe
*.dll
*.so
*.dylib
*.app
*.class
*.o
*.pyc
*.pyo
*.pyd
__pycache__/
.pytest_cache/
.eslintcache
.parcel-cache
.turbo/
.next/
.nuxt/

# --------------------------------------------------------------------
