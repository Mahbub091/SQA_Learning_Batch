# Copy this file to .env and fill in real values. Never commit .env.

# ---------- Application ----------
LANDING_PAGE_URL=https://your-app-url.com/

# ---------- Credentials of an account that does NOT exist (negative login tests) ----------
USER_EMAIL=unregistered-user@example.com
USER_PASSWORD=change-me

# ---------- Passwords used by generated users / negative scenarios ----------
NEW_USER_PASSWORD=change-me-strong
WRONG_PASSWORD=change-me-wrong
SHORT_PASSWORD=12345
MISMATCH_PASSWORD=change-me-different

# ---------- Domain used for generated (faker) e-mail addresses ----------
TEST_EMAIL_DOMAIN=example.com
