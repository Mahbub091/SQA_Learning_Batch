{
  "name": "sqa_learning_batch",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E suite for the Tricentis Demo Web Shop",
  "main": "index.js",
  "scripts": {
    "test:headless": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:e2e": "npx playwright test --grep @e2e",
    "test:auth": "npx playwright test --grep @auth",
    "test:registration": "npx playwright test --grep @registration",
    "test:login": "npx playwright test --grep @login",
    "test:catalog": "npx playwright test --grep @catalog",
    "test:navigation": "npx playwright test --grep @navigation",
    "test:search": "npx playwright test --grep @search",
    "typecheck": "tsc --noEmit",
    "report": "npx playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mahbub091/SQA_Learning_Batch.git"
  },
