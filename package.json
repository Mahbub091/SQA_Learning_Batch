  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Mahbub091/SQA_Learning_Batch/issues"
  },
  "homepage": "https://github.com/Mahbub091/SQA_Learning_Batch#readme",
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "zod": "^4.6.7"
  }
