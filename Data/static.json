  "catalog": {
    "sortableCategoryPath": "/books",
    "filterCandidatePaths": ["/desktops", "/notebooks", "/accessories", "/books"],
    "sortOptions": {
      "nameAsc": "Name: A to Z",
      "nameDesc": "Name: Z to A",
      "priceAsc": "Price: Low to High",
      "priceDesc": "Price: High to Low",
      "createdOn": "Created on"
    }
  },

  "search": {
    "exactName": "14.1-inch Laptop",
    "partialName": "laptop",
    "caseVariations": ["LAPTOP", "Laptop", "lApToP"],
    "tooShortTerms": ["a", "ab"],
    "specialCharacters": "!@#$%^&*()_+-=[]{};:'\",./?|~`",
    "advanced": {
      "keyword": "computer",
      "parentCategory": "Computers",
      "priceFrom": 1000,
      "priceTo": 1500,
      "impossiblePriceFrom": 999999
    }
  },

  "productDetail": {
    "_note": "Names/paths/messages below are the standard nopCommerce sample-data values the Demo Web Shop ships with. Re-check them against the live DOM before trusting exact-text assertions; 'expectedPrice: 0' means 'not verified yet, so only check the price is a positive number'.",

