{
  "compilerOptions": {
    "paths": {
      "@root/*": ["./*"]
    },
    "target": "ES2021",
    "module": "Node16",
    "lib": ["ES2021", "DOM"],
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
