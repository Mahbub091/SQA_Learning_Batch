{
  "compilerOptions": {
    // "@root/..." always means "start from the project root folder".
    // Example: '@root/Utilities/ActionUtils' instead of '../../Utilities/ActionUtils'.
    // Playwright reads this same setting, so the alias works when tests run, not only in the editor.
    "paths": {
      "@root/*": ["./*"]
    },
    "target": "ES2021",
    "module": "Node16",
    "lib": ["ES2021", "DOM"],
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "allowSyntheticDefaultImports": true,
    // Lets us `import data from '@root/Data/StaticData.json'`.
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
